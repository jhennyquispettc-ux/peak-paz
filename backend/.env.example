NODE_ENV=development
PORT=3010
API_PREFIX=api

DB_HOST=localhost
DB_PORT=5434
DB_USER=peakpaz
DB_PASSWORD=peakpaz_dev
DB_NAME=peak_paz
DB_LOGS=false

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

SEED_ADMIN_EMAIL=admin@peakpaz.bo
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Peak Paz

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_MS=5000
WEATHER_CACHE_MINUTES=30

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYMENT_DRIVER=fake
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/pagos/confirmar
PAYMENT_CANCEL_URL=http://localhost:5173/pagos/cancelado
TERMS_VERSION=1.0

# Must match the verification service; generate your own secret (32+ characters).
VERIFICATION_SERVICE_URL=http://localhost:3020
VERIFICATION_SERVICE_KEY=replace-with-a-random-internal-service-key-32-characters
VERIFICATION_TIMEOUT_MS=5000
RABBITMQ_URL=amqp://peakpaz:replace-with-rabbitmq-password@localhost:5672

# Notification emails. In development they go to Mailpit (http://localhost:8025).
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Peak Paz <avisos@peakpaz.local>
PUBLIC_WEB_URL=http://localhost:5173
